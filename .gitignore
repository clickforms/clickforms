# Dependencies
node_modules/
SAFE_TO_DELETE_stale_node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Next.js
.next/
out/

# Production build
build/
dist/

# Env files — never commit real secrets
.env
.env*.local

# Prisma
prisma/*.db

# Testing
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
*.pem

# AWS Client VPN: CA key, server/client certs, and .ovpn configs (embeds private keys) —
# generated locally by scripts/setup-client-vpn.sh, never commit
.vpn/

# Vercel (unused, but harmless to ignore if it ever appears)
.vercel

# TypeScript incremental build info
*.tsbuildinfo
AWSCLIV2.pkg

# Scratch/ad-hoc working files that have accumulated in the repo root — not part of the
# app, not meant to ever be committed (one-off document generation output, a QA
# screenshot, an unrelated editing script). Untracked, so ignoring them here just
# prevents a future `git add -A`/`git add .` from sweeping them in by accident.
/tmp/
/output/
.scratch-shot.js
.srl
edit_ali_duplicate.py
qa_page-01.png
