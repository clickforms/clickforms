// Clickforms — Prisma schema
//
// Source of truth: ARCHITECTURE.md §4 (data model) and specs/01-data-model-and-auth.md.
// Every tenant-scoped table carries `organizationId` (mapped to `organization_id`) even
// though there is exactly one organization today — this is what makes a future multi-tenant
// conversion (ARCHITECTURE.md §7) additive instead of a rewrite.
//
// Row-Level Security: Postgres RLS policies keyed off `current_setting('app.current_org_id')`
// are NOT expressed here — Prisma has no `CREATE POLICY` primitive. They are hand-written SQL
// in prisma/migrations/<ts>_add_row_level_security/migration.sql, appended after the table
// migration Prisma would normally generate. See src/lib/db.ts for the `withOrgContext` helper
// that sets the session variable per request, which is what makes those policies bite.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection string no longer lives here — it's resolved by
// prisma.config.ts (for the CLI) and by the driver adapter passed into
// PrismaClient at runtime (see src/lib/db.ts and prisma/seed.ts).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  admin
  member
  editor
  viewer

  @@map("user_role")
}

enum FormStatus {
  draft
  approved
  published
  archived

  @@map("form_status")
}

enum SubmissionStatus {
  in_progress
  submitted
  approved
  rejected

  @@map("submission_status")
}

enum WorkflowStepStatus {
  pending
  approved
  rejected

  @@map("workflow_step_status")
}

// What the respondent selected on the signup form for "which of the following most
// applies to you" — purely informational (sales/onboarding context), not used by any
// application logic.
enum SignupFormSituation {
  paper_form
  existing_online_form
  no_form

  @@map("signup_form_situation")
}

// Billing tier, shown on /admin/billing and used by src/lib/admin/plan-limits.ts to
// derive per-org form/user/storage/submission caps — see /pricing for the customer-facing
// version of the same table. Purely a label + lookup key today — no payment provider is
// wired up yet, so changing an org's plan (POST /api/admin/organizations/[id]/plan) just
// updates this column. Renamed from free/pro (see migration
// 20260924000000_rename_org_plan_tiers) when the pricing model grew from 3 tiers to the
// current 4 — existing orgs on the old `free` plan became `standard`, `pro` became
// `business`, and `professional` was added as a new tier between `business` and
// `enterprise`; no org retroactively lost or gained access, per the grandfathering
// decision at the time.
enum OrgPlan {
  standard
  business
  professional
  enterprise

  @@map("org_plan")
}

// Platform-admin-controlled lifecycle state, independent of `plan`. `suspended` blocks
// sign-in for every user in the org (see the check in src/lib/auth.ts) without deleting
// any data — the reversible alternative to /admin's "Delete organisation".
enum OrgStatus {
  active
  trial
  suspended

  @@map("org_status")
}

// Clickforms staff permission level within /admin itself — orthogonal to `User.role`,
// which only ever describes standing within a customer Organization. Nullable on User:
// most platform admins today are `super_admin` since that's all the invite flow grants,
// but `support` exists so future invites can hand out read-only access.
enum PlatformAdminRole {
  super_admin
  support

  @@map("platform_admin_role")
}

// Which address a form's "new response" email notification goes to (see
// Form.notificationMode below): org_default defers to Organization.notificationEmail,
// custom uses the form's own notificationEmail, off never sends one regardless of what
// the org has configured.
enum FormNotificationMode {
  org_default
  custom
  off

  @@map("form_notification_mode")
}

// Lifecycle of a platform-admin-authored FormTemplate (specs follow-up: template
// library). draft = still being built in /admin/templates, invisible to organisations.
// published = shown in the org-side /forms/templates gallery and offered by POST
// /api/forms's templateId. archived = removed from that gallery for *new* forms, but
// never affects any Form already copied from it — copying is a one-time schema clone,
// not a live link (see FormTemplate doc comment below).
enum TemplateStatus {
  draft
  published
  archived

  @@map("template_status")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  // Public-form tenant identifier — resolved by src/middleware.ts from the request
  // hostname ({subdomain}.{ROOT_DOMAIN}) so a visitor filling in a form always sees
  // which org they're submitting to. Auto-generated from `name` at signup (see
  // src/lib/forms/slug.ts slugify/uniqueSlug), never user-typed.
  subdomain String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  // Org profile fields (specs 06 admin dashboard) — all optional, editable only by
  // org admins via /forms/settings/organisation (see src/app/api/organization/route.ts).
  // Not collected at signup; filled in later, so every existing org has these as null.
  abn          String? @map("abn")
  contactName  String? @map("contact_name")
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")
  // Where "a new response was submitted" emails go by default — distinct from
  // contactEmail above (that's a person to contact about the account/billing, not
  // necessarily who should be pinged on every submission). Null means no default is
  // configured; a form set to notificationMode: org_default with this null simply never
  // sends (see src/lib/forms/submission-notification.ts), same as a form set to `off`.
  // Individual forms can override this via Form.notificationMode/notificationEmail.
  notificationEmail String? @map("notification_email")

  // Uploaded via /forms/organisation (admins only — see src/app/api/organization/logo)
  // and shown in place of the default Clickforms wordmark in the org's own workspace
  // sidebar (src/app/forms/admin-sidebar.tsx). S3 key layout: org_id/logo/<uuid>-<filename>
  // (buildOrganizationLogoKey in src/lib/s3.ts). Null means no logo has been uploaded —
  // the default brand mark is shown instead.
  logoStorageKey String? @map("logo_storage_key")

  // Billing/lifecycle fields for /admin/billing and the Organisations list (specs: platform
  // admin console). No payment provider integration yet — `plan` and `status` are set
  // directly by platform admins via /api/admin/organizations/[id]/plan and .../status.
  plan        OrgPlan   @default(standard)
  status      OrgStatus @default(active)
  // Only meaningful while status = trial; null otherwise.
  trialEndsAt DateTime? @map("trial_ends_at")
  // Next billing-cycle date, shown on the Billing page. Set manually for now (no
  // subscription webhook), null until a platform admin fills it in.
  renewsAt    DateTime? @map("renews_at")

  users           User[]
  userInvites     UserInvite[]
  forms           Form[]
  formVersions    FormVersion[]
  submissions     Submission[]
  submissionFiles   SubmissionFile[]
  organizationFiles OrganizationFile[]
  signatures        Signature[]
  workflowSteps     WorkflowStep[]
  auditLogs         AuditLog[]
  emailLogs         EmailLog[]
  platformAdminOrgAccess PlatformAdminOrgAccess[]

  @@map("organizations")
}

model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  email          String
  name           String?
  phone          String?
  // Not itemized in ARCHITECTURE.md §4's abbreviated field list, but required by the
  // credentials provider described in specs/01-data-model-and-auth.md ("email + bcrypt
  // password hash"). bcryptjs-hashed, never the plaintext password.
  passwordHash   String   @map("password_hash")
  role           UserRole @default(member)
  // Platform-level flag, orthogonal to `role` (which is scoped to this user's own
  // organization). Clickforms staff who manage every organisation via /admin are
  // platform admins and do *not* belong to a customer Organization — `organizationId`
  // is null for them. `role: admin` only ever means "admin of my own org".
  isPlatformAdmin Boolean @default(false) @map("is_platform_admin")
  // Display-only today (see src/app/forms/settings/two-factor/two-factor-client.tsx —
  // enrollment has no backend yet). Also surfaced as a column on /admin/users.
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  // Permission level within /admin. Null for everyone except platform admins; see the
  // PlatformAdminRole enum doc comment for why this is separate from `role`.
  platformAdminRole PlatformAdminRole? @map("platform_admin_role")
  createdAt      DateTime @default(now()) @map("created_at")

  organization       Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedFiles      OrganizationFile[] @relation("OrganizationFileUploadedBy")
  createdForms       Form[]             @relation("FormCreatedBy")
  approvedWorkflows  WorkflowStep[]  @relation("WorkflowApprover")
  auditLogs          AuditLog[]      @relation("AuditActor")
  sentInvites        UserInvite[]    @relation("InviteSender")
  sentPlatformAdminInvites PlatformAdminInvite[] @relation("PlatformAdminInviteSender")
  passwordResetTokens PasswordResetToken[]
  platformAdminOrgAccess PlatformAdminOrgAccess[]
  createdFormTemplates FormTemplate[] @relation("FormTemplateCreatedBy")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model UserInvite {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  name           String?
  role           UserRole
  token          String    @unique
  invitedById    String    @map("invited_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Explicit Cascade (unlike PlatformAdminInvite.invitedBy below, which relies on the
  // implicit Restrict default) — deleting the inviting admin also clears their
  // still-pending invites, matching the original migration
  // (20260712000300_add_users_and_invites) which set this at the DB level. This
  // annotation was missing from the schema for a while, which caused `prisma migrate dev`
  // to think the FK should be Restrict and want to "fix" it back — fixed 2026-09-15.
  invitedBy    User         @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("user_invites")
}

// Invite flow for the /admin "Team" page, mirroring UserInvite's shape (token, expiry,
// accepted-at) but deliberately a separate model rather than reusing UserInvite: a
// platform admin belongs to no Organization at all (User.organizationId is null for
// them), whereas UserInvite.organizationId is required. Accepted via
// POST /api/admin/team/accept, which mirrors POST /api/invites/accept but creates a
// User with organizationId: null and platformAdminRole set instead.
model PlatformAdminInvite {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String             @unique
  name        String?
  role        PlatformAdminRole
  token       String             @unique
  invitedById String             @map("invited_by_id") @db.Uuid
  expiresAt   DateTime           @map("expires_at")
  acceptedAt  DateTime?          @map("accepted_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  invitedBy User @relation("PlatformAdminInviteSender", fields: [invitedById], references: [id])

  @@map("platform_admin_invites")
}

// Step 1 of self-service signup (POST /api/auth/signup): captures the org/contact
// details up front but does NOT create an Organization/User yet — that only happens
// once the emailed verification link is clicked and a password is set (POST
// /api/auth/signup/verify). Looked up by token pre-org-context, same as UserInvite,
// so it goes through the plain `prisma` client rather than `withOrgContext`.
model PendingSignup {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationName String              @map("organization_name")
  firstName        String              @map("first_name")
  lastName         String              @map("last_name")
  email            String
  phone            String
  formSituation    SignupFormSituation @map("form_situation")
  termsAcceptedAt  DateTime            @map("terms_accepted_at")
  token            String              @unique
  expiresAt        DateTime            @map("expires_at")
  completedAt      DateTime?           @map("completed_at")
  createdAt        DateTime            @default(now()) @map("created_at")

  // Re-submitting the signup form with the same email (e.g. the first link expired,
  // or the email never arrived) refreshes this row via upsert rather than piling up
  // duplicate pending rows — mirrors UserInvite's re-invite-refreshes-token behavior.
  @@unique([email])
  @@map("pending_signups")
}

// "Forgot password" flow: a short-lived, single-use token emailed to the user's
// address. No organization_id — like PendingSignup/UserInvite, this is looked up by
// token alone (the requester hasn't proven who they are yet), so it's read/written
// through the plain `prisma` client rather than withOrgContext, and carries no RLS
// policy (see the migration for why). userId is the source of truth for which
// organization the eventual password update belongs to.
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Form {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String     @map("organization_id") @db.Uuid
  name              String
  slug              String
  status            FormStatus @default(draft)
  // Nullable: a brand-new form has no published version yet. Points at whichever
  // form_versions row the public renderer (spec 03) should read.
  currentVersionId  String?    @unique @map("current_version_id") @db.Uuid
  createdBy         String     @map("created_by") @db.Uuid
  // Opt-out toggle (row action on the Forms list, see FormActionsMenu): when true, this
  // form is hidden from literally everyone in the org except its creator — no admin/editor
  // override. Enforced in application code (formsListWhere, assertFormViewAccess /
  // assertFormEditAccess), not RLS, since RLS's "forms" policy is org-scoped only.
  isPrivate         Boolean    @default(false) @map("is_private")
  // Free-text naming pattern for this form's PDF response downloads (Settings tab, see
  // src/app/forms/[id]/settings). Plain literal text plus the `{date}` token, swapped for
  // the response's submitted date at export time — see resolveFilenameTemplate in
  // src/lib/forms/generate-submission-pdf.ts. Null/empty means "use the default naming"
  // (form-name-2026-09-08.pdf, see submissionPdfFilename).
  pdfFilenameTemplate String?  @map("pdf_filename_template")
  // Which field's answer feeds the `{prefix}` token in pdfFilenameTemplate above (e.g. a
  // "Name" field so exports download as "Jane Doe - IR-2026-09-10.pdf"). Stores the
  // field's stable id from the *current* FormVersion.schema, not a position number — a
  // position is just how the Settings picker displays the choice ("2. Full name"), and
  // would silently point at the wrong field once fields are reordered/added/removed.
  // Null means no prefix is configured. Not a DB foreign key: the field it points to
  // lives inside FormVersion.schema's JSONB, not its own table, so referential integrity
  // is enforced in the PATCH /api/forms/[id] handler instead (checked against the current
  // schema at save time) rather than by Postgres.
  filenamePrefixFieldId String? @map("filename_prefix_field_id")
  // Who gets emailed when this form receives a new response (Settings tab, see
  // src/app/forms/[id]/settings) — org_default (the default) defers to
  // Organization.notificationEmail, custom uses notificationEmail below, off never
  // sends. See src/lib/forms/submission-notification.ts for the resolution logic and
  // the PATCH /api/f/[slug]/submissions/[submissionId] route for where it fires.
  notificationMode  FormNotificationMode @default(org_default) @map("notification_mode")
  // Only meaningful when notificationMode = custom; null/cleared whenever mode is
  // switched away from custom (enforced in PATCH /api/forms/[id]) so a stale address
  // never lingers unseen after switching back to org_default or off.
  notificationEmail String?    @map("notification_email")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User          @relation("FormCreatedBy", fields: [createdBy], references: [id])
  // All versions of this form, including drafts and the currently-published one.
  versions       FormVersion[] @relation("FormVersions")
  // The one version currently live on the public renderer, if published.
  currentVersion FormVersion?  @relation("FormCurrentVersion", fields: [currentVersionId], references: [id])
  submissions    Submission[]

  // Slug uniqueness is scoped per-org, not global, to match the multi-tenancy shaping
  // called out in ARCHITECTURE.md §7. The public route (`GET /f/:slug`) is org-scoped
  // via Organization.subdomain, resolved per-request by src/middleware.ts.
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("forms")
}

model FormVersion {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formId         String    @map("form_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  // { pages, fields, conditionalLogic, branding } — see specs/02-form-builder.md for the
  // exact shape. Validated at the application layer with Zod (never trust JSONB shape alone).
  schema         Json
  versionNumber  Int       @map("version_number")
  publishedAt    DateTime? @map("published_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  form         Form         @relation("FormVersions", fields: [formId], references: [id], onDelete: Cascade)
  // Inverse of Form.currentVersion — lets Prisma know a FormVersion may be "the" current
  // version of at most one form.
  currentForForm Form?      @relation("FormCurrentVersion")
  submissions    Submission[]

  @@unique([formId, versionNumber])
  @@index([organizationId])
  @@map("form_versions")
}

model Submission {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  formId         String           @map("form_id") @db.Uuid
  formVersionId  String           @map("form_version_id") @db.Uuid
  status         SubmissionStatus @default(in_progress)
  // Respondent answers keyed by fieldId, matching form_versions.schema.fields.
  answers        Json             @default("{}")
  // Random, unguessable token for the save-and-resume flow (spec 03). Null once a
  // submission is finalized — resuming a submitted/approved/rejected submission
  // isn't meaningful and a signed submission is read-only (spec 05).
  resumeToken    String?          @unique @map("resume_token")
  ipAddress      String?          @map("ip_address")
  submittedAt    DateTime?        @map("submitted_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  form          Form             @relation(fields: [formId], references: [id], onDelete: Cascade)
  formVersion   FormVersion      @relation(fields: [formVersionId], references: [id])
  files         SubmissionFile[]
  signatures    Signature[]
  workflowSteps WorkflowStep[]

  @@index([organizationId])
  @@index([formId, status])
  @@map("submissions")
}

model SubmissionFile {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId   String   @map("submission_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  fieldKey       String   @map("field_key")
  // S3 key layout: org_id/form_id/submission_id/filename (ARCHITECTURE.md §4).
  storageKey     String   @map("storage_key")
  filename       String
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  uploadedAt     DateTime @default(now()) @map("uploaded_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([submissionId])
  @@map("submission_files")
}

/// Admin-uploaded org library files (Files page). Separate from submission_files —
/// those are respondent uploads tied to a form answer; these are documents the org
/// stores directly (templates, policies, etc.) without a submission.
model OrganizationFile {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  uploadedById   String?  @map("uploaded_by_id") @db.Uuid
  // S3 key layout: org_id/library/<uuid>-<sanitized filename>
  storageKey     String   @map("storage_key")
  filename       String
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  uploadedAt     DateTime @default(now()) @map("uploaded_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation("OrganizationFileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("organization_files")
}

model Signature {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId       String   @map("submission_id") @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  fieldKey           String   @map("field_key")
  signatureImageKey  String   @map("signature_image_key")
  signerName         String   @map("signer_name")
  // Exact consent wording shown at signing time. Historical consent text is immutable
  // once used (spec 05) — never mutate a row this field points at.
  consentTextVersion String   @map("consent_text_version")
  ipAddress          String   @map("ip_address")
  userAgent          String   @map("user_agent")
  signedAt           DateTime @map("signed_at")
  // SHA-256 of (answers JSON + signature image bytes + signedAt), computed server-side
  // at signing time. Recomputing from stored data must match this exactly (spec 05).
  contentHash        String   @map("content_hash")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([submissionId])
  @@map("signatures")
}

/// Created now, unused until spec 07 (approval workflows). Kept in the schema from day
/// one specifically so adding the feature later doesn't require a migration that touches
/// every other table's RLS setup again.
model WorkflowStep {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId     String              @map("submission_id") @db.Uuid
  organizationId   String              @map("organization_id") @db.Uuid
  stepOrder        Int                 @map("step_order")
  approverUserId   String              @map("approver_user_id") @db.Uuid
  status           WorkflowStepStatus  @default(pending)
  actedAt          DateTime?           @map("acted_at")
  comments         String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  approver     User         @relation("WorkflowApprover", fields: [approverUserId], references: [id])

  @@index([organizationId])
  @@index([submissionId])
  @@map("workflow_steps")
}

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  // Nullable: public respondent actions (e.g. a form submission) have no admin actor.
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("audit_log")
}

enum EmailStatus {
  sent
  failed
  // RESEND_API_KEY isn't configured (local dev) — nothing was actually sent, the
  // message was only printed to the server console. Kept as its own status rather than
  // folding into 'sent' so a Files/audit-style view can't mistake dev traffic for real
  // delivery.
  dev_logged

  // Mapped to the snake_case Postgres type name (matching every other enum in this
  // schema, e.g. form_notification_mode) rather than leaving it as the literal
  // "EmailStatus" — omitting this caused `prisma migrate dev` to want to rename the type
  // to match the un-mapped default, undoing the hand-authored migration. Fixed 2026-09-15.
  @@map("email_status")
}

// One row per sendEmail() call (src/lib/email.ts) — every transactional email this app
// sends (signup verification, invites, password reset, submission notifications, the
// public contact form) writes here, success or failure. This is delivery bookkeeping,
// not a queue: sendEmail() calls the provider synchronously and logs the outcome
// afterward, it never reads this table to decide what to send.
model EmailLog {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Nullable and, like PasswordResetToken/PendingSignup, carries no RLS policy — plenty
  // of sends happen before any organization exists (signup verification) or aren't
  // org-scoped at all (platform-admin invites, the public contact form), and sendEmail()
  // is called from both inside and outside an org's withOrgContext transaction, so this
  // is always written through the plain `prisma` client.
  organizationId String? @map("organization_id") @db.Uuid
  toEmail        String  @map("to_email")
  subject        String
  // Machine-readable tag for which flow sent this — see the EmailKind union in
  // src/lib/email.ts (kept in sync by convention, not a DB enum, since new kinds are
  // added often and a migration per kind would be needless friction).
  kind   String
  status EmailStatus
  // Resend's message id on success — null on failure or when only dev-logged.
  providerMessageId String? @map("provider_message_id")
  // Best-effort provider error message on failure.
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([kind])
  @@index([createdAt])
  @@map("email_log")
}

// Audit trail for a Clickforms platform admin temporarily attaching themselves to a
// customer Organization (User.organizationId + role: admin) to do testing, bug fixes or
// investigation, then detaching again — see /admin/organisations/[id] "Join this
// organisation" and the "Leave organisation" banner in the org workspace
// (src/app/forms/temporary-org-banner.tsx). One row per join; `leftAt` null means the
// admin is still attached. This is what distinguishes a temporary platform-admin join
// from a genuine org employee who also happens to have isPlatformAdmin = true — see
// isTemporaryOrgJoin() in src/lib/auth.ts, which only returns true while an active
// (leftAt: null) row exists for the session's (userId, organizationId) pair.
//
// Deliberately carries NO RLS policy: it is only ever read/written via the plain
// `prisma` client from /admin routes and the NextAuth jwt callback, both of which are
// platform-admin-only and inherently cross-organization, same reasoning as EmailLog
// above.
model PlatformAdminOrgAccess {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  joinedAt       DateTime  @default(now()) @map("joined_at")
  leftAt         DateTime? @map("left_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("platform_admin_org_access")
}

// A reusable form definition authored by Clickforms staff in /admin/templates and
// offered to every organisation via the /forms/templates gallery (specs follow-up:
// template library). Deliberately org-less — no organizationId, no RLS policy — same
// reasoning as EmailLog/PlatformAdminOrgAccess above: only ever read/written through
// the plain `prisma` client from platform-admin-only routes (writes) or any
// authenticated org user (published-only reads via GET /api/form-templates).
//
// "Using" a template (POST /api/forms with a templateId) deep-clones `schema` into a
// brand-new Form + FormVersion for that organisation — a one-time snapshot, not a live
// link. Editing a template afterwards never touches forms already copied from it, and
// an organisation editing their copy never touches the template. Field/page ids inside
// `schema` are cloned verbatim rather than regenerated, since they're only ever
// referenced from within that one schema blob (see FormVersion.schema doc comment).
model FormTemplate {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  // Free-text, admin-typed (not an enum) — see the design note in
  // src/app/admin/templates: keeps adding a new category a content change, not a
  // migration, while the library is still small enough that a rigid taxonomy would
  // just get in the way.
  category    String?
  status      TemplateStatus @default(draft)
  // Same shape/validation (formSchemaSchema) as FormVersion.schema — see
  // src/lib/forms/schema.ts. Edited via src/app/admin/templates/[id]/builder, a
  // lighter-weight editor composed from the same Canvas/FieldPalette/
  // FieldSettingsPanel pieces as the org-facing form builder (not BuilderClient
  // itself, which is tightly coupled to form workflow/versioning/live-edit-gating
  // that templates don't have).
  schema      Json
  // Uploaded via the template settings panel, same presign/confirm/delete S3 pattern
  // as Organization.logoStorageKey. Null means no thumbnail — the gallery falls back
  // to a generic template icon.
  thumbnailStorageKey String? @map("thumbnail_storage_key")
  createdBy   String         @map("created_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  creator User @relation("FormTemplateCreatedBy", fields: [createdBy], references: [id])

  @@index([status])
  @@map("form_templates")
}
